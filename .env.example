# Required for accounts, sessions, conversations, decisions, and attachments.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/worthit

# NVIDIA NIM — keep the key server-side and copy these to .env.local.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
